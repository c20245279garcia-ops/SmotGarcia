---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
const name = "Smot Garcia";
const position = "Web Developer";
---

<html lang="en" class="dark">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>{name} | {position}</title>
    </head>
    <body class="min-h-screen bg-blue-600 text-white dark:bg-slate-950">
        <script>
            import { FallingLeaves } from "falling-leaves";

            new FallingLeaves({ shapes: ["maple", "oak", "ginkgo", "birch", "oval"] });
        </script>
        <div
            id="progressBar"
            class="fixed inset-x-0 top-0 z-50 h-1 origin-left scale-x-0 bg-gradient-to-r from-pink-400 via-violet-400 to-cyan-400"
        ></div>
        <Header />
        <slot />
        <Footer />
        <script>
            import "../scripts/animations.js";
        </script>
    </body>
</html>