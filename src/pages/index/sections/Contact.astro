<section id="contact" class="mb-10 w-full">
<div class="reveal w-full rounded-[18px] bg-[#5f138f] p-5 text-white shadow-md sm:p-6 lg:p-8">
        <h2 class="text-[2.2rem] font-black leading-none text-white">Contact Me</h2>

        <p class="mt-3 mb-5 text-lg text-white/80">Have a question or idea? Send me a message.</p>

        <form id="contact-form" class="space-y-4">
            <div>
                <label for="name" class="mb-2 block text-[1.05rem] font-semibold text-white">Your Name</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Enter your name"
                    class="w-full rounded-lg border border-[#2b1c3f] bg-[#0f1c2d] px-4 py-3 text-white placeholder:text-slate-400 focus:border-pink-400 focus:outline-none focus:ring-2 focus:ring-pink-300/40"
                    required
                />
            </div>

            <div>
                <label for="email" class="mb-2 block text-[1.05rem] font-semibold text-white">Email Address</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email"
                    class="w-full rounded-lg border border-[#2b1c3f] bg-[#0f1c2d] px-4 py-3 text-white placeholder:text-slate-400 focus:border-pink-400 focus:outline-none focus:ring-2 focus:ring-pink-300/40"
                    required
                />
            </div>

            <div>
                <label for="message" class="mb-2 block text-[1.05rem] font-semibold text-white">Message</label>
                <textarea
                    id="message"
                    name="message"
                    rows="4"
                    placeholder="Write your message"
                    class="w-full rounded-lg border border-[#ff4fb7] bg-[#0f1c2d] px-4 py-3 text-white placeholder:text-slate-400 focus:border-pink-400 focus:outline-none focus:ring-2 focus:ring-pink-300/40"
                    required
                ></textarea>
            </div>

            <button type="submit" class="w-full rounded-lg bg-[#ff4fb7] px-5 py-4 text-xl font-semibold text-white transition hover:bg-[#ff5ec0]">
                Send Message
            </button>

            <p id="form-notice" class="text-sm text-pink-100" aria-live="polite"></p>
        </form>
    </div>
</section>
