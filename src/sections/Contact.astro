<section id="contact" class="mb-10">
            <div class="card">
                <h2 class="text-2xl font-bold text-purple-950 dark:text-white">
                    Contact Me
                </h2>


                <p class="mt-2 mb-6 text-purple-950 dark:text-purple-100">
                    Have a question or idea? Send me a message.
                </p>


                <form id="contact-form" class="space-y-4">


                    <div>
                        <label for="name"
                            class="mb-2 block font-semibold text-purple-950 dark:text-white">
                            Your Name
                        </label>
                        <input type="text" id="name" name="name"
                            placeholder="Enter your name"
                            class="field" required>
                    </div>


                    <div>
                        <label for="email"
                            class="mb-2 block font-semibold text-purple-950 dark:text-white">
                            Email Address
                        </label>
                        <input type="email" id="email" name="email"
                            placeholder="Enter your email"
                            class="field" required>
                    </div>


                    <div>
                        <label for="message"
                            class="mb-2 block font-semibold text-purple-950 dark:text-white">
                            Message
                        </label>
                        <textarea id="message" name="message" rows="4"
                            placeholder="Write your message"
                            class="field" required></textarea>
                    </div>


                    <button type="submit" class="btn w-full">
                        Send Message
                    </button>


                    <p id="form-notice"
                       class="text-sm text-purple-800 dark:text-pink-300"
                       aria-live="polite"></p>


                </form>
            </div>
        </section>

